// ──────────────────────────────────────────────────────
// Actionable Justice OS — Prisma Schema
// See docs/EXECUTION_PLAN.md §5 for the design rationale.
// ──────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Urgency {
  CRITICAL
  HIGH
  NORMAL
}

enum GrievanceStatus {
  PENDING
  FILED
  FOLLOWED_UP
  ESCALATED
  RESOLVED
}

enum EventKind {
  FILED
  FOLLOWUP_7D
  ESCALATION_14D
  SOS_BROADCAST
  USER_UPDATE
  COMMUNITY_NOTICE
}

enum EventSource {
  SYSTEM
  OFFICER
  USER
}

enum Channel {
  EMAIL
  SMS
  WHATSAPP
  SYSTEM
}

// ─── Models ─────────────────────────────────────────────

model User {
  id              String             @id @default(cuid())
  clerkId         String             @unique
  fullName        String
  primaryPin      String?
  /// E.164 phone, optional; used for SOS and profile
  phone           String?
  /// Free-text home locality / neighbourhood
  location        String?
  /// Whether the user has completed the onboarding modal
  profileComplete Boolean            @default(false)
  contacts        EmergencyContact[]
  grievances      Grievance[]
  /// SOS broadcast records (no grievance row)
  noticeEventsSos NoticeEvent[]      @relation("SosUserNoticeEvents")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model EmergencyContact {
  id       String  @id @default(cuid())
  userId   String
  name     String
  phone    String
  relation String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Officer {
  id              String      @id @default(cuid())
  name            String
  designation     String
  department      String
  jurisdictionPin String
  email           String
  parentId        String?
  parent          Officer?    @relation("Hierarchy", fields: [parentId], references: [id])
  children        Officer[]   @relation("Hierarchy")
  grievances      Grievance[]
  createdAt       DateTime    @default(now())

  @@index([jurisdictionPin, department])
  @@index([parentId])
}

model Grievance {
  id           String          @id @default(cuid())
  userId       String
  rawText      String
  language     String          @default("en")
  category     String
  urgency      Urgency
  statute      String
  section      String
  officerId    String
  status       GrievanceStatus @default(PENDING)
  pin          String
  /// Free-text locality within the PIN (e.g. "Chandni Chowk")
  locality     String?
  lat          Float?
  lng          Float?
  filedAt      DateTime?
  resolvedAt   DateTime?
  /// When true, sender identity is hidden from the authority email
  isAnonymous  Boolean         @default(false)
  /// "fast" compresses 7d/7d+ delays in demos (X-Demo-Speed); otherwise null
  demoSpeed    String?
  events       NoticeEvent[]
  communityMemberships CommunityGrievanceMember[]
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  officer      Officer         @relation(fields: [officerId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, status])
  @@index([officerId])
  @@index([pin])
  @@index([pin, category])
  @@index([isAnonymous])
}

model NoticeEvent {
  id          String      @id @default(cuid())
  /// Set when the event is tied to a notice lifecycle; null for standalone SOS
  grievanceId String?
  /// Set for SOS_BROADCAST when grievanceId is null
  userId      String?
  kind        EventKind
  channel     Channel
  /// Who created this event (default SYSTEM)
  source      EventSource @default(SYSTEM)
  /// Human-readable message for USER_UPDATE events
  message     String?
  payload     Json
  sentAt      DateTime    @default(now())
  user        User?       @relation("SosUserNoticeEvents", fields: [userId], references: [id], onDelete: Cascade)
  grievance   Grievance?  @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  @@index([grievanceId, kind])
  @@index([userId, kind])
}

/// A CommunityGrievance is auto-created when ≥5 similar complaints cluster
/// in the same locality+category within 72 hours.
model CommunityGrievance {
  id          String                    @id @default(cuid())
  pin         String
  locality    String?
  category    String
  status      GrievanceStatus           @default(PENDING)
  count       Int                       @default(0)
  officerId   String?
  emailSentAt DateTime?
  members     CommunityGrievanceMember[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([pin, category])
  @@index([status])
}

model CommunityGrievanceMember {
  id                  String             @id @default(cuid())
  communityGrievanceId String
  grievanceId         String
  community           CommunityGrievance @relation(fields: [communityGrievanceId], references: [id], onDelete: Cascade)
  grievance           Grievance          @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  addedAt             DateTime           @default(now())

  @@unique([communityGrievanceId, grievanceId])
  @@index([communityGrievanceId])
  @@index([grievanceId])
}
