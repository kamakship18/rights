{
  "name": "@repo/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --port 4000",
    "prebuild": "pnpm --filter @repo/shared run build",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --forceExit --detectOpenHandles",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clerk/backend": "^1",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "@repo/prisma": "workspace:^",
    "@repo/shared": "workspace:*",
    "@sendgrid/mail": "^8",
    "axios": "^1",
    "bullmq": "^5.34.8",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "handlebars": "^4",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "twilio": "^5",
    "uuid": "^11",
    "zod": "^3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.12.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10",
    "jest": "^30.3.0",
    "nock": "^14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.7.3"
  }
}
