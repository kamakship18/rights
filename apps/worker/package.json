{
  "name": "@repo/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --port 4001",
    "prebuild": "pnpm --filter @repo/shared run build",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "test": "jest --forceExit --detectOpenHandles",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@repo/prisma": "workspace:^",
    "@repo/shared": "workspace:*",
    "@sendgrid/mail": "^8",
    "bullmq": "^5.34.8",
    "ioredis": "^5.4.2",
    "node-cron": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.12.0",
    "@types/node-cron": "^3.0.11",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.7.3"
  }
}
