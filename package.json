{
  "name": "actionable-justice-os",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @repo/prisma run build && pnpm --filter @repo/shared run build && pnpm --filter './apps/*' --parallel run dev",
    "dev:web": "pnpm --filter @repo/web dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "dev:worker": "pnpm --filter @repo/worker dev",
    "dev:chain": "cd apps/chain && node src/main.js",
    "build": "pnpm --filter './apps/*' --filter './packages/*' run build",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @repo/prisma generate",
    "db:migrate:dev": "pnpm --filter @repo/prisma migrate:dev",
    "db:migrate:deploy": "pnpm --filter @repo/prisma migrate:deploy",
    "db:push": "pnpm --filter @repo/prisma db:push",
    "db:seed": "pnpm --filter @repo/prisma db:seed",
    "db:seed:perf": "pnpm --filter @repo/prisma db:seed:perf",
    "db:studio": "pnpm --filter @repo/prisma studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
