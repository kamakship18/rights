# ──────────────────────────────────────────────────────
# Actionable Justice OS — Root Environment Variables
# Copy to .env and fill in your values.
# NEVER commit the .env file — it's in .gitignore.
# ──────────────────────────────────────────────────────

# ── Database (local Docker default) ──────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/justice_os?schema=public"
REDIS_URL="redis://localhost:6379"

# ── AI / LLM ────────────────────────────────────────
GROQ_API_KEY=""
PINECONE_API_KEY=""

# ── Auth (Clerk) — https://dashboard.clerk.com → Application → API Keys ──
# CLERK_SECRET_KEY="sk_test_...."   # backend (Nest) only, never in browser
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_...."  # web app only (public)

# ── Email ────────────────────────────────────────────
# SENDGRID_API_KEY=""

# ── SMS / WhatsApp ───────────────────────────────────
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_SMS=""
# TWILIO_FROM_WHATSAPP=""

# ── Geo (server-side only; never use in Next.js public env) ─
# GOOGLE_PLACES_API_KEY="AIza..."  # Google Cloud: enable Places API (New) or legacy Places

# ── Voice ────────────────────────────────────────────
# BHASHINI_USER_ID=""
# BHASHINI_API_KEY=""

# ── Legal ────────────────────────────────────────────
# INDIAN_KANOON_API_KEY=""

# ── Demo Seed ────────────────────────────────────────
DEMO_OFFICER_EMAIL="team@actionablejustice.dev"
DEMO_PHONE_1="+919999999991"
DEMO_PHONE_2="+919999999992"
